QDRANT_PATH=./data/qdrant
# Docker Compose host ports. Override only when these ports are already used.
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5433
# Optional Docker host cache override. By default, start_docker.sh uses
# $HOME/.cache/huggingface without storing a machine-specific path here.
# HF_CACHE_DIR=/path/to/huggingface

# Authentication. Docker Compose injects its internal PostgreSQL URL. Native
# start_backend.sh bootstraps the Compose database on POSTGRES_PORT; Render
# should inject DATABASE_URL from its managed PostgreSQL service.
AUTH_ENABLED=false
DATABASE_URL=postgresql+psycopg://reguaz:reguaz_local_only@127.0.0.1:5433/reguaz
AUTH_COOKIE_NAME=reguaz_session
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_DAYS=7
# Local Docker only. Use a long URL-safe value outside development.
POSTGRES_PASSWORD=reguaz_local_only
# JSON array required by pydantic-settings for cross-origin native development.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LLM_MODEL_PATH=./backend/reguaz/models/gemma-4-E4B-it-Q4_K_M.gguf
LLM_GPU_LAYERS=-1
REGUAZ_PIPELINE_VERSION=v2
# Leave QDRANT_URL empty for local embedded Qdrant. Render uses a Qdrant Cloud
# cluster endpoint and keeps its API key only in backend secrets.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=30
LLM_TYPE=gemma
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_GPT_OSS_MODEL=openai/gpt-oss-120b
NVIDIA_GPT_OSS_CONTEXT_WINDOW=131072
NVIDIA_GPT_OSS_MAX_TOKENS=4096
NVIDIA_GPT_OSS_TIMEOUT_SECONDS=300
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_API_KEY=your_groq_api_key_here
GROQ_GPT_OSS_20B_MODEL=openai/gpt-oss-20b
GROQ_GPT_OSS_120B_MODEL=openai/gpt-oss-120b
GROQ_GPT_OSS_CONTEXT_WINDOW=131072
GROQ_GPT_OSS_MAX_TOKENS=2048
GROQ_GPT_OSS_TIMEOUT_SECONDS=90
GROQ_GPT_OSS_REASONING_EFFORT=low

# Optional answer text-to-speech via OpenRouter. Keep the key server-side.
OPENROUTER_TTS_ENABLED=true
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro-free:free
# Public Azerbaijani male narrator voice; pinning it keeps speaker identity stable.
OPENROUTER_TTS_VOICE=1db26754d7d84db39b8463c322c8d162
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_TITLE=ReguAZ
OPENROUTER_TTS_TIMEOUT_SECONDS=60
OPENROUTER_TTS_MAX_INPUT_CHARACTERS=5000
OPENROUTER_TTS_MAX_AUDIO_BYTES=15728640
OPENROUTER_TTS_MAX_CONCURRENCY=2
OPENROUTER_TTS_MAX_RETRIES=1
GOLD_DATASET_PATH=./data/evaluation/gold_dataset_for_llm_generation.xlsx
RESULTS_PATH=./results
LOGS_PATH=./logs

# DeepSeek Judge LLM (via NVIDIA NIM API)
NVIDIA_API_KEY=your_nvidia_api_key_here
JUDGE_MODEL=deepseek-ai/deepseek-v4-flash
JUDGE_TEMPERATURE=0.1
JUDGE_MAX_TOKENS=4096
