QDRANT_PATH=./data/qdrant
LLM_MODEL_PATH=./backend/reguaz/models/gemma-4-E4B-it-Q4_K_M.gguf
LLM_GPU_LAYERS=-1
REGUAZ_PIPELINE_VERSION=v2
LLM_TYPE=gemma
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_GPT_OSS_MODEL=openai/gpt-oss-120b
NVIDIA_GPT_OSS_CONTEXT_WINDOW=131072
NVIDIA_GPT_OSS_MAX_TOKENS=4096
NVIDIA_GPT_OSS_TIMEOUT_SECONDS=300
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_API_KEY=your_groq_api_key_here
GROQ_GPT_OSS_20B_MODEL=openai/gpt-oss-20b
GROQ_GPT_OSS_120B_MODEL=openai/gpt-oss-120b
GROQ_GPT_OSS_CONTEXT_WINDOW=131072
GROQ_GPT_OSS_MAX_TOKENS=2048
GROQ_GPT_OSS_TIMEOUT_SECONDS=90
GROQ_GPT_OSS_REASONING_EFFORT=low
GOLD_DATASET_PATH=./data/evaluation/gold_dataset_for_llm_generation.xlsx
RESULTS_PATH=./results
LOGS_PATH=./logs

